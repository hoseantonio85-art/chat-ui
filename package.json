{
  "name": "@n-orm/chat-mf-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "types"
  ],
  "scripts": {
    "env:dev": "cross-env NODE_ENV=development",
    "env:prod": "cross-env NODE_ENV=production",
    "dev": "concurrently \"npm run build:dev -- --watch --mode development\" \"npm run preview -- --mode development\"",
    "start": "npm run env:dev && npm run dev",
    "build:dev": "npm run env:dev -- vite build",
    "build": "npm run env:prod && vite build && npm run build -w types",
    "preview": "vite preview --port 4403",
    "format": "biome check --fix --unsafe ./src",
    "lint": "biome check ./src",
    "lint:ts": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "npm run clean:node-modules && npm run clean:dist",
    "clean:node-modules": "rm -rf node_modules",
    "clean:dist": "rm -rf dist",
    "debug:eslint": "eslint --print-config \"./src/index.tsx\" > eslint-output-config.json",
    "debug:prettier": "prettier \"./src/index.tsx\" --loglevel debug",
    "debug:ts": "tsc --showConfig",
    "prepare": "husky || true",
    "publish": "npm run release -w types"
  },
  "dependencies": {
    "@reatom/framework": "^3.4.52",
    "@reatom/npm-react": "3.4.2",
    "@stomp/stompjs": "^6.1.2",
    "i18next": "^23.16.5",
    "i18next-browser-languagedetector": "^6.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.1.1",
    "sass-embedded": "^1.81.0",
    "single-spa": "^6.0.3",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3",
    "@biomejs/cli-linux-x64": "^1.9.3",
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@reatom/testing": "^3.4.8",
    "@sber-orm/biome-config": "^0.3.177",
    "@sber-orm/eslint-config": "*",
    "@sber-orm/eslint-plugin": "*",
    "@sber-orm/prettier-config": "*",
    "@sber-orm/tsconfig-config": "*",
    "@sber-orm/types__auth-mf-app": "^1.1.0",
    "@sber-orm/types__components": "^1.5.0",
    "@sber-orm/types__ui-kit": "^0.8.0",
    "@testing-library/react": "^16.2.0",
    "@types/d3": "^7.1.0",
    "@types/file-saver": "^2.0.5",
    "@types/markdown-it": "^13.0.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-istanbul": "^3.0.4",
    "classnames": "^2.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "d3": "^7.3.0",
    "exceljs": "^4.3.0",
    "file-saver": "^2.0.5",
    "globals": "^15.9.0",
    "html2canvas": "^1.4.1",
    "husky": "^9.1.6",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^26.0.0",
    "mobile-detect": "^1.4.5",
    "pretty-quick": "^4.0.0",
    "single-spa-react": "^6.0.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.10",
    "vite-plugin-checker": "^0.10.0",
    "vite-plugin-externalize-dependencies": "^1.0.1",
    "vite-plugin-single-spa": "^0.7.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.4"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "engines": {
    "node": ">=18.16.1"
  },
  "homepage": "https://stash.sigma.sbrf.ru/projects/SBERORM-ENABLERS/repos/sberorm-cloud-chat-front/browse",
  "repository": {
    "type": "git",
    "url": "https://stash.sigma.sbrf.ru/scm/sberorm-enablers/sberorm-cloud-chat-front.git"
